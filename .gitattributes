# Normalize line endings
* text=auto

# Python source
*.py text

# Dart source
*.dart text

# Config / data formats
*.json text
*.yml text
*.yaml text
*.xml text

# SQL
*.sql text

# Markdown
*.md text

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
